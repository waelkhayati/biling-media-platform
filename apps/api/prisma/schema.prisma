generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum StaffRole {
  ADMIN
  EDITOR
}

enum StaffChallengeKind {
  INVITE
  SETUP
  RECOVERY
  ENROLL
  MFA
}

model StaffAccount {
  id           String           @id @default(cuid())
  email        String           @unique
  passwordHash String
  role         StaffRole
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now())
  sessions     StaffSession[]
  challenges   StaffChallenge[]
  authVersion  Int              @default(0)
  mfaSecret    String?
  lastTotpStep Int?
}

model StaffSession {
  tokenHash   String       @id @db.Char(64)
  accountId   String
  account     StaffAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  authVersion Int

  @@index([accountId])
  @@index([expiresAt])
}

model StaffChallenge {
  tokenHash   String             @id @db.Char(64)
  accountId   String
  account     StaffAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind        StaffChallengeKind
  authVersion Int
  expiresAt   DateTime
  attempts    Int                @default(0)
  secret      String?

  @@index([accountId, kind])
  @@index([expiresAt])
}

model StudioAuditEvent {
  id             String         @id @default(cuid())
  actorId        String?
  actor          String
  resource       String
  resourceId     String
  title          String
  action         String
  previousStatus ContentStatus?
  nextStatus     ContentStatus?
  createdAt      DateTime       @default(now())

  @@index([createdAt, id])
  @@index([resource, createdAt, id])
}

model StaffLoginThrottle {
  key          String   @id @db.Char(64)
  attempts     Int
  windowEndsAt DateTime

  @@index([windowEndsAt])
}

model User {
  arcadeRuns ArcadeRun[]
  dailyQuizProgress DailyQuizProgress[]
  id               String              @id @default(cuid())
  email            String              @unique
  username         String?             @unique
  passwordHash     String?
  displayName      String?
  biography        String?
  avatarUrl        String?
  emailVerifiedAt  DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  sessions         AudienceSession[]
  challenges       AudienceChallenge[]
  comments         CommunityComment[]
  commentReports   CommentReport[]
  commentReactions CommentReaction[]
  articleReactions ArticleReaction[]
  episodeReactions EpisodeReaction[]
  followedShows    ShowFollow[]
  gameAttempts     GameAttempt[]
}

enum AudienceChallengeKind {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model AudienceSession {
  tokenHash String   @id @db.Char(64)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

model AudienceChallenge {
  tokenHash String                @id @db.Char(64)
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      AudienceChallengeKind
  expiresAt DateTime

  @@unique([userId, kind])
  @@index([expiresAt])
}

model AudienceThrottle {
  key          String   @id @db.Char(64)
  attempts     Int
  windowEndsAt DateTime

  @@index([windowEndsAt])
}

model Show {
  id               String             @id @default(cuid())
  title            String
  slug             String             @unique
  description      String?            @db.Text
  posterUrl        String?
  featured         Boolean            @default(false)
  status           ContentStatus      @default(DRAFT)
  metadata         Json?
  firstPublishedAt DateTime?
  episodes         Episode[]
  articles         Article[]
  comments         CommunityComment[]
  followers        ShowFollow[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([status, createdAt])
}

model Episode {
  id               String             @id @default(cuid())
  showId           String
  show             Show               @relation(fields: [showId], references: [id], onDelete: Cascade)
  title            String
  slug             String
  description      String?            @db.Text
  episodeNumber    Int?
  durationSeconds  Int?
  youtubeVideoId   String?            @unique @db.VarChar(11)
  status           ContentStatus      @default(DRAFT)
  publishedAt      DateTime?
  firstPublishedAt DateTime?
  metadata         Json?
  articles         Article[]
  comments         CommunityComment[]
  reactions        EpisodeReaction[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([showId, slug])
  @@index([showId, status, publishedAt])
}

model Article {
  id               String             @id @default(cuid())
  slug             String             @unique
  title            String
  excerpt          String?
  body             Json
  author           String
  category         String
  tags             String[]
  language         String             @default("en")
  imageUrl         String?
  imageAlt         String?
  imageCaption     String?
  imageCredit      String?
  featured         Boolean            @default(false)
  status           ContentStatus      @default(DRAFT)
  publishedAt      DateTime?
  firstPublishedAt DateTime?
  seoTitle         String?
  seoDescription   String?
  shows            Show[]
  episodes         Episode[]
  comments         CommunityComment[]
  reactions        ArticleReaction[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([status, publishedAt, id])
  @@index([status, category, publishedAt])
  @@index([status, featured, publishedAt])
  @@index([author, updatedAt])
  @@index([tags], type: Gin)
}

enum CommunityCommentStatus {
  VISIBLE
  HIDDEN
  REMOVED
}

enum CommunityReactionType {
  LIKE
}

enum CommentReportReason {
  SPAM
  HARASSMENT
  HATEFUL
  SEXUAL
  VIOLENCE
  MISINFORMATION
  OTHER
}

enum CommentReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

model CommunityComment {
  id        String                 @id @default(cuid())
  userId    String
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  articleId String?
  article   Article?               @relation(fields: [articleId], references: [id], onDelete: Cascade)
  episodeId String?
  episode   Episode?               @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  showId    String?
  show      Show?                  @relation(fields: [showId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    CommunityComment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   CommunityComment[]     @relation("CommentReplies")
  body      String                 @db.VarChar(2000)
  status    CommunityCommentStatus @default(VISIBLE)
  reports   CommentReport[]
  reactions CommentReaction[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@index([articleId, status, createdAt, id])
  @@index([episodeId, status, createdAt, id])
  @@index([showId, status, createdAt, id])
  @@index([parentId, status, createdAt, id])
  @@index([userId, createdAt])
}

model CommentReport {
  id         String              @id @default(cuid())
  commentId  String
  comment    CommunityComment    @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User                @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     CommentReportReason
  details    String?             @db.VarChar(500)
  status     CommentReportStatus @default(OPEN)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([commentId, reporterId])
  @@index([status, createdAt, id])
}

model CommentReaction {
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId String
  comment   CommunityComment      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  type      CommunityReactionType @default(LIKE)
  createdAt DateTime              @default(now())

  @@id([userId, commentId, type])
  @@index([commentId, type])
}

model ArticleReaction {
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  articleId String
  article   Article               @relation(fields: [articleId], references: [id], onDelete: Cascade)
  type      CommunityReactionType @default(LIKE)
  createdAt DateTime              @default(now())

  @@id([userId, articleId, type])
  @@index([articleId, type])
}

model EpisodeReaction {
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodeId String
  episode   Episode               @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  type      CommunityReactionType @default(LIKE)
  createdAt DateTime              @default(now())

  @@id([userId, episodeId, type])
  @@index([episodeId, type])
}

model ShowFollow {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  showId    String
  show      Show     @relation(fields: [showId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, showId])
  @@index([showId])
}

model CommunityModerationEvent {
  id        String   @id @default(cuid())
  actorId   String
  actor     String
  commentId String
  action    String
  note      String?  @db.VarChar(500)
  createdAt DateTime @default(now())

  @@index([commentId, createdAt, id])
  @@index([createdAt, id])
}

enum GameType {
  TRIVIA
  PERSONALITY
  DAILY_CHALLENGE
}

model Game {
  id                String        @id @default(cuid())
  slug              String        @unique
  title             String
  description       String?       @db.Text
  artworkUrl        String?
  type              GameType
  featured          Boolean       @default(false)
  status            ContentStatus @default(DRAFT)
  availableFrom     DateTime?
  availableUntil    DateTime?
  timeLimitSeconds  Int?
  questions         GameQuestion[]
  outcomes          GameOutcome[]
  attempts          GameAttempt[]
  dailyProgress     DailyQuizProgress[]
  firstPublishedAt  DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status, type, createdAt])
  @@index([status, featured, createdAt])
}

model GameQuestion {
  id          String       @id @default(cuid())
  gameId      String
  game        Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  position    Int
  prompt      String       @db.VarChar(1000)
  explanation String?      @db.VarChar(2000)
  options     GameOption[]

  @@unique([gameId, position])
}

model GameOption {
  id          String       @id @default(cuid())
  questionId  String
  question    GameQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  position    Int
  text        String       @db.VarChar(500)
  correct     Boolean      @default(false)
  outcomeKey  String?      @db.VarChar(80)

  @@unique([questionId, position])
}

model GameOutcome {
  id          String @id @default(cuid())
  gameId      String
  game        Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  key         String @db.VarChar(80)
  title       String @db.VarChar(160)
  description String @db.VarChar(2000)
  imageUrl    String?

  @@unique([gameId, key])
}

model GameAttempt {
  id                String   @id @default(cuid())
  gameId            String
  game              Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId            String?
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  official          Boolean  @default(false)
  dailyDate         String?  @db.VarChar(10)
  score             Int
  totalQuestions    Int
  outcomeKey        String?  @db.VarChar(80)
  answers           Json
  completedAt       DateTime @default(now())

  @@unique([gameId, userId, dailyDate])
  @@index([userId, completedAt])
  @@index([gameId, official, completedAt])
}

enum ArcadeKind {
  MOT
  LINKS
  RECALL
}

model ArcadePuzzle {
  id          String     @id @default(cuid())
  slug        String
  title       String
  description String
  date        String
  kind        ArcadeKind
  published   Boolean    @default(false)
  definition  Json
  runs        ArcadeRun[]

  @@unique([slug, date])
  @@index([date, published])
}

model ArcadeRun {
  id        String       @id @default(cuid())
  puzzleId  String
  puzzle    ArcadePuzzle @relation(fields: [puzzleId], references: [id], onDelete: Restrict)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deadline  DateTime
  revision  Int          @default(0)
  progress  Json

  @@unique([puzzleId, userId])
  @@index([userId])
}

model DailyQuizProgress {
  gameId       String
  game         Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         String
  gameRevision DateTime
  revision     Int      @default(0)
  answers      Json

  @@id([gameId, userId, date])
  @@index([userId])
}
