# Local PostgreSQL connection. Use a stronger password outside local development.
DATABASE_URL=postgresql://biling:biling_dev@localhost:5432/biling_media?schema=public
POSTGRES_DB=biling_media
POSTGRES_USER=biling
POSTGRES_PASSWORD=biling_dev

# API settings
PORT=3001
CORS_ORIGIN=http://127.0.0.1:3000
API_BASE_URL=http://127.0.0.1:3001/api/v1
NODE_ENV=development

# Staff authenticator encryption key. Generate a persistent 32-byte base64url secret for each environment.
# STAFF_MFA_KEY=

# Exact public web origin. Set on API and web for custom origins, including alternate local ports.
# AUDIENCE_WEB_ORIGIN=http://127.0.0.1:3000
# On the API only. Both are needed to enable hosted registration and account email.
# AUDIENCE_RESEND_API_KEY=
# AUDIENCE_EMAIL_FROM=
